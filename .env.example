# Guardian Matrix Environment Configuration Example
# Copy this file to .env and insert your real credentials.

# LLM Reasoning & Vision Forensics (optional)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# CCTV / RTSP Live Stream Configuration
CCTV_RTSP_URL=rtsp://127.0.0.1:8554/live
MODEL_PATH=yolov8n.pt
POSE_MODEL_PATH=yolov8n-pose.pt
DETECTION_CONFIDENCE=0.35
POSE_CONFIDENCE=0.35
TARGET_FPS=15
FRAME_SKIP=1
MAX_TRACKS=20
ALERT_CONFIDENCE=0.80
ALERT_CONFIRMATION_FRAMES=10
ALERT_COOLDOWN_SECONDS=30
INCIDENT_OUTPUT_DIR=incidents
PRE_EVENT_BUFFER_SECONDS=5
POST_EVENT_BUFFER_SECONDS=5
